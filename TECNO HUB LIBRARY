-- Apply Selected Language
local function applyLanguage(langName)
	local data = Translations[langName] or Translations["English"]
	centerTitle.Text = data.centerTitle
	smallTitle.Text = data.smallTitle
	subtitle.Text = data.credit
	if modalTitle then modalTitle.Text = data.surePrompt end
	if yesBtn then yesBtn.Text = data.yes end
	if noBtn then noBtn.Text = data.no end
	if setModalTitle then setModalTitle.Text = data.settings end
end

